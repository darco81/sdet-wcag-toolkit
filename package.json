{
  "name": "sdet-wcag-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "WCAG 2.2 AA accessibility toolkit for modern web applications",
  "license": "AGPL-3.0-or-later",
  "author": "Dariusz Kowalski <darecki9k@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darco81/sdet-wcag-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "lint": "pnpm -r --filter './packages/*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
