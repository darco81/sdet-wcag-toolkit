{
  "name": "@sdet-wcag-toolkit/static-analyzer",
  "version": "0.1.1",
  "description": "Static analysis of source code for WCAG 2.2 AA issues",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "echo \"(no lint yet)\""
  },
  "dependencies": {
    "@sdet-wcag-toolkit/core": "workspace:*",
    "cheerio": "^1.0.0",
    "colord": "^2.9.3",
    "domhandler": "^5.0.3",
    "postcss": "^8.4.47"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "vitest": "^2.1.4"
  }
}
