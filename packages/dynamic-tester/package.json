{
  "name": "@sdet-wcag-toolkit/dynamic-tester",
  "version": "0.2.0",
  "description": "Browser-based WCAG 2.2 AA testing via Playwright and axe-core",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "echo \"(no lint yet)\""
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@sdet-wcag-toolkit/core": "workspace:*",
    "axe-core": "^4.10.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "vitest": "^2.1.4"
  }
}
