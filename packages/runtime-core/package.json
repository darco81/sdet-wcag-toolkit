{
  "name": "@sdet-wcag-toolkit/runtime-core",
  "version": "0.3.0",
  "description": "Runtime adapter contract, structured JSON parser, HardGuard tool sanitizer, and shared specialist prompts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts-index.d.ts",
      "default": "./dist/prompts-index.js"
    }
  },
  "files": [
    "dist",
    "src/prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-prompts",
    "copy-prompts": "mkdir -p dist/prompts && cp src/prompts/*.md dist/prompts/ 2>/dev/null || true",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"(no lint yet)\""
  },
  "dependencies": {
    "@sdet-wcag-toolkit/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
